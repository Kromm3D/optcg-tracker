# Copia este archivo a .env (gitignored) para apuntar a tu propio proyecto de
# Supabase en local/CI/EAS. Si se omite, config.ts cae al proyecto por defecto.
#
# Project Settings → API → Project URL / Project API keys → anon public.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
